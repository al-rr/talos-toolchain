#!/usr/bin/env bash
# Test fixture only: stub colima CLI for scripts/talos/local-cluster.sh
# tests. Never starts or configures a real Colima instance. Not a real
# colima build.
set -euo pipefail

if [[ -n "${STUB_COLIMA_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "${STUB_COLIMA_LOG}"
fi

if [[ "$1" == "status" ]]; then
  if [[ "${STUB_COLIMA_STATUS_FAIL:-false}" == "true" ]]; then
    echo "stub colima: not running" >&2
    exit 1
  fi
  echo "stub colima: running"
  if [[ -n "${STUB_COLIMA_DOCKER_SOCKET:-}" ]]; then
    # Mirrors real Colima, which reports the socket inside a logfmt line
    # rather than as a bare "docker: <uri>" field. An earlier stub emitted
    # only the bare form, which let a parser that could not read real Colima
    # output pass the whole suite. STUB_COLIMA_STATUS_FORMAT=plain still
    # exercises the plainer form so both stay covered.
    if [[ "${STUB_COLIMA_STATUS_FORMAT:-logfmt}" == "plain" ]]; then
      echo "docker: unix://${STUB_COLIMA_DOCKER_SOCKET}"
    else
      echo "time=\"2026-01-01T00:00:00+00:00\" level=info msg=\"runtime: docker\""
      echo "time=\"2026-01-01T00:00:00+00:00\" level=info msg=\"docker socket: unix://${STUB_COLIMA_DOCKER_SOCKET}\""
    fi
  fi
  exit 0
fi

exit 0
